{
  "schemaVersion": 1,
  "id": "chainmine",
  "version": "${version}",
  "name": "ChainMine Core",
  "description": "Mine entire veins in one swing — the spiritual successor of Vein Miner. Sneak to chain-break blocks in a regular shape.",
  "authors": [
    "ChainMine Dev"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/chainmine",
    "sources": "https://github.com/sansenjian/ChainMine-Core"
  },
  "license": "MIT",
  "icon": "assets/chainmine/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.chainmine.ChainMine"
    ],
    "client": [
      "com.chainmine.ChainMineClient"
    ],
    "modmenu": [
      "com.chainmine.client.ChainMineModMenu"
    ]
  },
  "mixins": [
    "chainmine.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.10",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
